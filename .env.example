# ===========================================
# CONFIGURACION MEDICIONES IA
# ===========================================
# Copia este archivo a .env y configura tus valores
# cp .env.example .env

# Puerto del servidor (cambia si ya tienes algo en 3003)
# Puertos comunes libres: 3050, 4000, 8080, 9000
PORT=3003

# API Key de OpenRouter (OBLIGATORIO)
# Una sola key da acceso a GPT, Claude, Gemini y Perplexity.
# Obtenla en: https://openrouter.ai/keys
# Nota: normalmente se configura por usuario desde la propia app
# (Configuracion > API Keys), que la guarda cifrada. Esta variable es
# el fallback para entornos sin usuario.
OPENROUTER_API_KEY=

# Secreto para cifrar las API keys guardadas por usuario (OBLIGATORIO en produccion)
# Genera uno con: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=

# ---------------------------------------------------------------
# Integraciones directas ELIMINADAS (ago 2026)
# ---------------------------------------------------------------
# OpenAI deprecó gpt-4o-search-preview y gpt-4o-mini-search-preview, los
# únicos modelos que soportaban `web_search_options` en chat/completions.
# En vez de mantener varias integraciones, todo pasa por OpenRouter.
# Estas variables ya NO se usan; se dejan documentadas para que nadie
# las vuelva a añadir esperando que hagan algo:
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_AI_API_KEY

# Secreto para JWT (cambiar en produccion)
# Genera uno con: openssl rand -base64 32
JWT_SECRET=cambiar-este-secreto-en-produccion

# URL de la API para el frontend (dejar vacio si es mismo servidor)
VITE_API_BASE_URL=

# Dominio (solo si usas Traefik en produccion)
DOMAIN=mediciones.tudominio.com